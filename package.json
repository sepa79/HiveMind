{
  "name": "hivemind",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Standalone MCP memory service for agent and team development context",
  "scripts": {
    "bootstrap:hivemind": "node scripts/bootstrap-hivemind.mjs",
    "bootstrap:demo": "./bootstrap.sh",
    "doctor": "node scripts/hivemind-work-unit.mjs doctor",
    "hivemind:init": "node scripts/hivemind-work-unit.mjs init",
    "hivemind:refresh-demo": "node scripts/refresh-demo-state.mjs",
    "hivemind:standard": "node scripts/hivemind-standard.mjs",
    "hivemind:save-demo": "./scripts/save-demo-state.sh",
    "hivemind:work": "node scripts/hivemind-work-unit.mjs",
    "pack:mcp": "mkdir -p dist && npm pack ./hivemind-mcp --pack-destination dist",
    "start:api": "node hivemind-api/src/server.mjs",
    "start:api:opensearch": "HIVEMIND_STORAGE_BACKEND=opensearch node hivemind-api/src/server.mjs",
    "start:mcp": "node hivemind-mcp/src/server.mjs",
    "test": "vitest run",
    "test:hivemind": "vitest run hivemind-api/src hivemind-mcp/src scripts/bootstrap-hivemind.test.mjs scripts/hivemind-work-unit.test.mjs scripts/hivemind-standard.test.mjs scripts/opensearch-init.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "hono": "^4.13.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
